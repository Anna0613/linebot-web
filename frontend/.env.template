# ========================================
# LineBot-Web 前端環境配置範本
# ========================================
# 複製此檔案為 .env 或 .env.local 並填入實際值

# 🚀 統一後端 API 配置（推薦使用）
# 根據部署環境修改此 URL
VITE_UNIFIED_API_URL=https://api.your-domain

# 🌐 開發伺服器配置
VITE_DEV_SERVER_HOST=0.0.0.0
VITE_DEV_SERVER_PORT=3000

# 🔐 允許的主機名稱（用逗號分隔）
# 根據實際部署的域名或 IP 修改
VITE_ALLOWED_HOSTS=localhost,127.0.0.1,your-domain,api.your-domain,linebot.your-domain

# 🔄 代理配置
# 遠端 HTTPS 環境設為 true
VITE_PROXY_SECURE=true
# 修改請求的 origin header
VITE_PROXY_CHANGE_ORIGIN=true

# ========================================
# 📝 部署環境說明
# ========================================
# 開發環境（本地）:
#   VITE_UNIFIED_API_URL=http://127.0.0.1:8000
#   VITE_DEV_SERVER_HOST=::
#   VITE_DEV_SERVER_PORT=8080
#   VITE_ALLOWED_HOSTS=localhost,127.0.0.1
#   VITE_PROXY_SECURE=false

# 生產環境（伺服器）:
#   VITE_UNIFIED_API_URL=https://api.your-domain
#   VITE_DEV_SERVER_HOST=0.0.0.0
#   VITE_DEV_SERVER_PORT=3000
#   VITE_ALLOWED_HOSTS=your-domain,api.your-domain
#   VITE_PROXY_SECURE=true
