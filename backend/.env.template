# ========================================
# LineBot-Web 後端環境配置範本
# ========================================
# 複製此檔案為 .env 並填入實際值

# 基本設定
DEBUG=False
ENVIRONMENT=production
SHOW_DOCS=False
LOG_LEVEL=INFO
SQL_ECHO=False

# 資料庫連線池設定
POOL_SIZE=10
POOL_MAX_OVERFLOW=20
POOL_TIMEOUT=15

# 資料庫設定 - 主庫（寫入）
# 使用現有的伺服器 PostgreSQL 服務
DB_HOST=postgresql15
DB_PORT=5432
DB_NAME=linebot_web
DB_USER=linebot_user
DB_PASSWORD=CHANGE_ME_SECURE_PASSWORD

# 資料庫設定 - 從庫（讀取，可選）
ENABLE_READ_WRITE_SPLITTING=False
DB_REPLICA_PORT=5433

# JWT 設定
# ⚠️ 務必生成強密鑰：openssl rand -hex 32
JWT_SECRET=CHANGE_ME_SECURE_KEY_MIN_32_CHARS
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=180
JWT_REMEMBER_EXPIRE_MINUTES=10080
TOKEN_REFRESH_THRESHOLD=0.5

# LINE 登入設定
# 從 LINE Developers 控制台取得
LINE_CHANNEL_ID=YOUR_LINE_CHANNEL_ID
LINE_CHANNEL_SECRET=YOUR_LINE_CHANNEL_SECRET
LINE_REDIRECT_URI=https://your-domain/api/v1/auth/line/callback

# 應用密鑰
FLASK_SECRET_KEY=CHANGE_ME_SECURE_KEY

# 前端 URL
FRONTEND_URL=https://your-domain

# 郵件設定（SMTP）
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=your_email@example.com
MAIL_PASSWORD=your_app_password

# Redis 設定
# 使用現有的伺服器 Redis 服務
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=
REDIS_URL=redis://redis:6379/0

# MinIO 設定（媒體存儲）
MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=CHANGE_ME_SECURE_PASSWORD
MINIO_SECURE=False
MINIO_BUCKET_NAME=message-store
MINIO_PUBLIC_URL=http://minio:9000

# MongoDB 設定（對話記錄）
MONGODB_HOST=mongodb
MONGODB_PORT=27017
MONGODB_DATABASE=linebot_conversations
MONGODB_SSL=False

# AI 設定
AI_PROVIDER=groq
GROQ_API_KEY=CHANGE_ME_YOUR_GROQ_API_KEY
GROQ_MODEL=llama-3.3-70b-versatile
AI_MAX_HISTORY_MESSAGES=200

# 安全設定
SECRET_KEY=CHANGE_ME_SECURE_KEY

# CORS 設定
EXTRA_ALLOWED_ORIGINS=
